source "https://rubygems.org"

# Matches the GitHub Pages build environment exactly.
gem "github-pages", group: :jekyll_plugins

# Plugins used by this site (also listed in _config.yml).
group :jekyll_plugins do
  gem "jekyll-feed"
  gem "jekyll-seo-tag"
  gem "jekyll-sitemap"
end

# Helps local `jekyll serve` on newer Ruby versions.
gem "webrick", "~> 1.8"

# Lock the platform so `bundle install` resolves the same way everywhere.
gem "tzinfo-data", platforms: [:mingw, :mswin, :x64_mingw, :jruby]
